{
  "name": "motungi-radio",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "verify": "npm run test && npm run build",
    "tauri": "node scripts/desktop.mjs",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/*.mjs\" vite.config.ts",
    "preview:ui": "vite --mode ui-preview --host 127.0.0.1 --port 1421 --strictPort"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "hls.js": "^1.7.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
